<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Grupo Administrador (Redes) en la categoría Servicios / Proyectos -->
        <record id="group_redes_admin" model="res.groups">
            <field name="name">Administrador (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Grupo Diseñador (Redes) en la categoría Servicios / Proyectos -->
        <record id="group_redes_designer" model="res.groups">
            <field name="name">Diseñador (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo Usuario (Redes) -->
        <record id="group_redes_user" model="res.groups">
            <field name="name">Usuario (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Hacer que el grupo Administrador de Proyectos de Odoo herede Administrador (Redes) -->
        <record id="project.group_project_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <!-- Reglas para Proyectos de Redes (project.project) -->
        <record id="project_project_redes_admin_rule" model="ir.rule">
            <field name="name">Proyectos de Redes: acceso total Administrador</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <record id="project_project_redes_designer_rule" model="ir.rule">
            <field name="name">Proyectos de Redes: acceso lectura Diseñador</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_designer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Reglas para Tareas de Redes (project.task) -->
        <record id="project_task_redes_admin_rule" model="ir.rule">
            <field name="name">Tareas de Redes: acceso Administrador global</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <record id="project_task_redes_designer_rule" model="ir.rule">
            <field name="name">Tareas de Redes: Diseñador sólo ve sus tareas asignadas</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_redes_designer'))]"/>
        </record>

        <!-- Reglas para Diseños Simplificados (design.design) -->
        <record id="design_design_redes_admin_rule" model="ir.rule">
            <field name="name">Diseño Simplificado: acceso total Administrador</field>
            <field name="model_id" search="[('model', '=', 'design.design')]" model="ir.model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <record id="design_design_redes_designer_rule" model="ir.rule">
            <field name="name">Diseño Simplificado: Diseñador sólo ve sus diseños asignados</field>
            <field name="model_id" search="[('model', '=', 'design.design')]" model="ir.model"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('task_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_redes_designer'))]"/>
        </record>
    </data>
</odoo>
