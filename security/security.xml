<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Grupo Administrador (Redes) en la categorÃ­a Servicios / Proyectos -->
        <record id="group_redes_admin" model="res.groups">
            <field name="name">Administrador (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <!-- Usuario de Proyecto: entra a la app Proyecto y puede crear/duplicar tareas -->
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Grupo DiseÃ±ador (Redes) en la categorÃ­a Servicios / Proyectos -->
        <record id="group_redes_designer" model="res.groups">
            <field name="name">DiseÃ±ador (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Grupo Usuario (Redes) -->
        <record id="group_redes_user" model="res.groups">
            <field name="name">Usuario (Redes)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Hacer que el grupo Administrador de Proyectos de Odoo herede Administrador (Redes) -->
        <record id="project.group_project_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <!-- Reglas para Proyectos de Redes (project.project) -->
        <record id="project_project_redes_admin_rule" model="ir.rule">
            <field name="name">Proyectos de Redes: acceso total Administrador</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <record id="project_project_redes_designer_rule" model="ir.rule">
            <field name="name">Proyectos de Redes: acceso lectura DiseÃ±ador</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_designer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Reglas para Tareas de Redes (project.task) -->
        <record id="project_task_redes_admin_rule" model="ir.rule">
            <field name="name">Tareas de Redes: Administrador ve todas</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="project_task_redes_admin_write_rule" model="ir.rule">
            <field name="name">Tareas de Redes: Administrador edita sÃ³lo tareas de proyectos de Redes</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('project_id.is_redes_project', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="project_task_redes_designer_rule" model="ir.rule">
            <field name="name">Tareas: DiseÃ±ador solo sus tareas asignadas</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])] if user.has_group('Modulo-Redes---Extension-de-dise-o.group_redes_designer') and not user.has_group('Modulo-Redes---Extension-de-dise-o.group_redes_admin') else [(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('Modulo-Redes---Extension-de-dise-o.group_redes_designer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- RestricciÃ³n: el Administrador (Redes) que NO es Administrador de Proyectos sÃ³lo ve Redes.
             Son reglas globales (sin grupos) porque las de grupo se suman (OR) con las de Usuario de Proyecto
             y no restringen. La condiciÃ³n va en el dominio; al resto de los usuarios no los afecta. -->
        <record id="project_project_redes_only_rule" model="ir.rule">
            <field name="name">Administrador (Redes): sÃ³lo proyectos de Redes</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('is_redes_project', '=', True)] if user.has_group('Modulo-Redes---Extension-de-dise-o.group_redes_admin') and not user.has_group('project.group_project_manager') else [(1, '=', 1)]</field>
        </record>

        <record id="project_task_redes_only_rule" model="ir.rule">
            <field name="name">Administrador (Redes): sÃ³lo tareas de proyectos de Redes</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|', ('project_id', '=', False), ('project_id.is_redes_project', '=', True)] if user.has_group('Modulo-Redes---Extension-de-dise-o.group_redes_admin') and not user.has_group('project.group_project_manager') else [(1, '=', 1)]</field>
        </record>

        <!-- Reglas para DiseÃ±os Simplificados (design.design) -->
        <record id="design_design_redes_admin_rule" model="ir.rule">
            <field name="name">DiseÃ±o Simplificado: acceso total Administrador</field>
            <field name="model_id" search="[('model', '=', 'design.design')]" model="ir.model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_redes_admin'))]"/>
        </record>

        <record id="design_design_redes_designer_rule" model="ir.rule">
            <field name="name">DiseÃ±o Simplificado: DiseÃ±ador sÃ³lo ve sus diseÃ±os asignados</field>
            <field name="model_id" search="[('model', '=', 'design.design')]" model="ir.model"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('task_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_redes_designer'))]"/>
        </record>
    </data>
</odoo>

