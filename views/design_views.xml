<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Formulario de Diseño extendida para Diseño Simplificado -->
        <record id="view_design_design_form_redes" model="ir.ui.view">
            <field name="name">design.design.form.redes</field>
            <field name="model">design.design</field>
            <field name="inherit_id" ref="ModuloDisenoOdoo.view_form_design"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('es_diseno_simplificado', '=', False)]}">
                        ⚡ <strong>Diseño Simplificado de Redes Sociales</strong>: Este diseño consta de 1 sola etapa y checklist reducido. Al ser aprobado, pasa directamente a completado.
                    </div>
                </xpath>

                <xpath expr="//field[@name='categoria_id']" position="after">
                    <field name="es_diseno_simplificado" readonly="1"/>
                </xpath>
            </field>
        </record>

        <!-- Vista Lista de Diseños con indicador de Diseño Simplificado -->
        <record id="view_design_design_tree_redes" model="ir.ui.view">
            <field name="name">design.design.tree.redes</field>
            <field name="model">design.design</field>
            <field name="inherit_id" ref="ModuloDisenoOdoo.view_tree_design"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='etapa']" position="after">
                    <field name="es_diseno_simplificado" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>


        <!-- Vista de Búsqueda y Filtros Dinámicos para Diseños Simplificados de Redes -->
        <record id="view_design_search_redes" model="ir.ui.view">
            <field name="name">design.design.search.redes</field>
            <field name="model">design.design</field>
            <field name="arch" type="xml">
                <search string="Buscar Diseños Simplificados">
                    <field name="name"/>
                    <field name="cliente_id"/>
                    <field name="task_id"/>
                    
                    <filter string="📌 Pendientes de Aprobación" name="pendientes"
                            domain="[('state', 'in', ['borrador', 'validacion', 'cliente', 'correcciones_solicitadas'])]"/>
                    <filter string="✅ Aprobados / Completados" name="aprobados"
                            domain="[('state', '=', 'aprobado')]"/>
                    
                    <separator/>
                    <group expand="0" string="Agrupar Por">
                        <filter string="Cliente" name="group_by_cliente" context="{'group_by': 'cliente_id'}"/>
                        <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Etapa" name="group_by_etapa" context="{'group_by': 'etapa'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
