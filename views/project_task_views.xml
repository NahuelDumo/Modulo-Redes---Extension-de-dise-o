<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Formulario de Tarea extendida para Redes Sociales -->
        <record id="view_task_form2_redes" model="ir.ui.view">
            <field name="name">project.task.form.redes</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="design_id" invisible="1"/>
                    <button name="action_open_associated_design"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-picture-o"
                            attrs="{'invisible': [('design_id', '=', False)]}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Diseño</span>
                            <span class="o_stat_text">Simplificado</span>
                        </div>
                    </button>
                </xpath>

                <xpath expr="//sheet//field[@name='project_id']" position="after">
                    <field name="es_tarea_redes"/>
                    <field name="tipo_tarea_redes" attrs="{'invisible': [('es_tarea_redes', '=', False)]}"/>
                    <field name="red_social" attrs="{'invisible': [('tipo_tarea_redes', '!=', 'campana_paga')]}"/>
                    <field name="design_id" attrs="{'invisible': [('design_id', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <!-- Vista Kanban de Tareas Pendientes de Diseñadores con diseño limpio -->
        <record id="view_task_kanban_designers" model="ir.ui.view">
            <field name="name">project.task.kanban.designers</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="user_ids" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="user_ids"/>
                    <field name="date_deadline"/>
                    <field name="stage_id"/>
                    <field name="design_id"/>
                    <field name="project_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click p-3 border-left border-primary rounded bg-white shadow-sm mb-2">
                                <div class="o_kanban_record_top mb-1">
                                    <div class="o_kanban_record_headings">
                                        <span class="badge badge-info mb-1"><field name="project_id"/></span>
                                        <strong class="o_kanban_record_title d-block font-weight-bold text-dark"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body small text-muted my-2">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="mr-2">📅 <strong>Vencimiento:</strong></span>
                                        <span class="badge badge-warning"><field name="date_deadline"/></span>
                                    </div>
                                    <div t-if="record.design_id.raw_value" class="mt-2">
                                        <button name="action_open_associated_design" type="object" class="btn btn-sm btn-outline-primary btn-block text-left">
                                            🎨 <strong>Abrir Diseño Simplificado</strong>
                                        </button>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="stage_id" widget="label_selection"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_ids" widget="many2many_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista de Búsqueda y Filtros Dinámicos para Tareas de Redes -->
        <record id="view_task_search_redes" model="ir.ui.view">
            <field name="name">project.task.search.redes</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <search string="Buscar Tareas de Redes">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="user_ids"/>
                    <field name="design_id"/>
                    
                    <filter string="⚡ Esta Semana (Próximos 7 días)" name="esta_semana"
                            domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_deadline', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="📌 Tareas Pendientes" name="pendientes"
                            domain="[('stage_id.fold', '=', False)]"/>
                    <filter string="🎨 Solo Diseños Simplificados" name="solo_disenos"
                            domain="[('tipo_tarea_redes', '=', 'diseno_simplificado')]"/>
                    
                    <separator/>
                    <group expand="0" string="Agrupar Por">
                        <filter string="Diseñador / Asignado" name="group_by_user" context="{'group_by': 'user_ids'}"/>
                        <filter string="Proyecto" name="group_by_project" context="{'group_by': 'project_id'}"/>
                        <filter string="Etapa" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
