<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Acciones de Ventana del Módulo de Redes -->

        <!-- Acción: Proyectos de Redes -->
        <record id="action_redes_projects" model="ir.actions.act_window">
            <field name="name">Proyectos de Redes Sociales</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_redes_project', '=', True)]</field>
            <field name="context">{'default_is_redes_project': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primer proyecto de Redes Sociales
                </p>
                <p>
                    Gestiona los contratos por meses, la grilla de las 11 tareas automatizadas y los diseños simplificados.
                </p>
            </field>
        </record>

        <!-- Acción: Tareas Pendientes de Diseñadores -->
        <record id="action_redes_designer_tasks" model="ir.actions.act_window">
            <field name="name">Tareas Pendientes de Diseñadores</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="search_view_id" ref="view_task_search_redes"/>
            <field name="domain">[('es_tarea_redes', '=', True), ('tipo_tarea_redes', '=', 'diseno_simplificado')]</field>
            <field name="context">{'search_default_esta_semana': 1, 'search_default_pendientes': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay tareas de diseño pendientes para esta semana
                </p>
            </field>
        </record>

        <!-- Acción: Diseños Simplificados -->
        <record id="action_redes_diseno_simplificado" model="ir.actions.act_window">
            <field name="name">Diseños Simplificados (Redes)</field>
            <field name="res_model">design.design</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_design_search_redes"/>
            <field name="domain">[('es_diseno_simplificado', '=', True)]</field>
            <field name="context">{'default_es_diseno_simplificado': True, 'search_default_pendientes': 1}</field>
        </record>

        <!-- Acción: Calendario de Publicaciones -->
        <record id="action_redes_calendar_tasks" model="ir.actions.act_window">
            <field name="name">Calendario de Publicaciones</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">calendar,tree,kanban,form</field>
            <field name="domain">[('es_tarea_redes', '=', True), ('tipo_tarea_redes', '=', 'publicacion')]</field>
        </record>

        <!-- Acción: Plantillas de Planes de Redes -->
        <record id="action_redes_plan_templates" model="ir.actions.act_window">
            <field name="name">Plantillas de Planes de Redes</field>
            <field name="res_model">redes.plan.template</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Acción: Plantillas de Checklist Corto -->
        <record id="action_redes_checklist_short_templates" model="ir.actions.act_window">
            <field name="name">Checklist Corto (Diseño Simplificado)</field>
            <field name="res_model">design.checklist_template</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_simplified', '=', True)]</field>
            <field name="context">{'default_is_simplified': True}</field>
        </record>


        <!-- ======================================================= -->
        <!-- ESTRUCTURA DEL MENÚ SUPERIOR EN LA APP DISEÑOS          -->
        <!-- ======================================================= -->

        <!-- Botón 1: Menú Desplegable 'Diseños' -->
        <menuitem id="menu_diseno_main_dropdown"
                  name="Diseños"
                  parent="ModuloDisenoOdoo.menu_diseno_root"
                  sequence="10"/>

        <!-- Submenús de 'Diseños' -->
        <menuitem id="menu_diseno_tradicional_lista"
                  name="Diseños"
                  parent="menu_diseno_main_dropdown"
                  action="ModuloDisenoOdoo.action_diseno_design"
                  sequence="10"/>

        <menuitem id="menu_diseno_tradicional_plantillas"
                  name="Plantillas de Checklist"
                  parent="menu_diseno_main_dropdown"
                  action="ModuloDisenoOdoo.action_diseno_checklist_template"
                  sequence="20"/>


        <!-- Botón 2: Menú Desplegable 'Redes' -->
        <menuitem id="menu_redes_root"
                  name="Redes"
                  parent="ModuloDisenoOdoo.menu_diseno_root"
                  sequence="20"/>

        <!-- Submenús de 'Redes' con reemplazo explícito de groups_id en base de datos -->
        <record id="menu_redes_proyectos" model="ir.ui.menu">
            <field name="name">Proyectos de Redes</field>
            <field name="parent_id" ref="menu_redes_root"/>
            <field name="action" ref="action_redes_projects"/>
            <field name="sequence" type="int">10</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin')])]"/>
        </record>

        <record id="menu_redes_disenadores" model="ir.ui.menu">
            <field name="name">Tareas Pendientes Diseñadores</field>
            <field name="parent_id" ref="menu_redes_root"/>
            <field name="action" ref="action_redes_designer_tasks"/>
            <field name="sequence" type="int">20</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin'), ref('group_redes_designer')])]"/>
        </record>

        <record id="menu_redes_disenos" model="ir.ui.menu">
            <field name="name">Diseños Simplificados</field>
            <field name="parent_id" ref="menu_redes_root"/>
            <field name="action" ref="action_redes_diseno_simplificado"/>
            <field name="sequence" type="int">30</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin'), ref('group_redes_designer')])]"/>
        </record>

        <record id="menu_redes_calendario" model="ir.ui.menu">
            <field name="name">Calendario de Publicaciones</field>
            <field name="parent_id" ref="menu_redes_root"/>
            <field name="action" ref="action_redes_calendar_tasks"/>
            <field name="sequence" type="int">40</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin')])]"/>
        </record>

        <record id="menu_redes_configuracion" model="ir.ui.menu">
            <field name="name">Configuración Redes</field>
            <field name="parent_id" ref="menu_redes_root"/>
            <field name="sequence" type="int">100</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin')])]"/>
        </record>

        <record id="menu_redes_config_planes" model="ir.ui.menu">
            <field name="name">Planes de Redes</field>
            <field name="parent_id" ref="menu_redes_configuracion"/>
            <field name="action" ref="action_redes_plan_templates"/>
            <field name="sequence" type="int">10</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin')])]"/>
        </record>

        <record id="menu_redes_config_checklist" model="ir.ui.menu">
            <field name="name">Checklist Corto (Simplificado)</field>
            <field name="parent_id" ref="menu_redes_configuracion"/>
            <field name="action" ref="action_redes_checklist_short_templates"/>
            <field name="sequence" type="int">20</field>
            <field name="groups_id" eval="[(6, 0, [ref('group_redes_admin')])]"/>
        </record>
    </data>
</odoo>
