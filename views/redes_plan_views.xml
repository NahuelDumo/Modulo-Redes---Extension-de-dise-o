<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Formulario de Plantilla de Plan de Redes -->
        <record id="view_redes_plan_template_form" model="ir.ui.view">
            <field name="name">redes.plan.template.form</field>
            <field name="model">redes.plan.template</field>
            <field name="arch" type="xml">
                <form string="Plantilla de Plan de Redes">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ej: Plan Redes Básico - 8 Publis/Mes"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Configuración de Contrato">
                                <field name="duracion_meses"/>
                                <field name="publis_por_semana"/>
                                <field name="publis_por_mes"/>
                                <field name="incluye_campana_paga"/>
                                <field name="dias_anticipacion_diseno"/>
                                <field name="redes_sociales"/>
                                <field name="active"/>
                            </group>
                            <group string="Responsables por Defecto">
                                <field name="user_abril_id" widget="many2one_avatar_user"/>
                                <field name="user_vero_id" widget="many2one_avatar_user"/>
                                <field name="user_barbara_id" widget="many2one_avatar_user"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Lista de Plantilla de Plan de Redes -->
        <record id="view_redes_plan_template_tree" model="ir.ui.view">
            <field name="name">redes.plan.template.tree</field>
            <field name="model">redes.plan.template</field>
            <field name="arch" type="xml">
                <tree string="Plantillas de Planes de Redes" create="true">
                    <field name="name"/>
                    <field name="duracion_meses"/>
                    <field name="publis_por_semana"/>
                    <field name="publis_por_mes"/>
                    <field name="incluye_campana_paga"/>
                    <field name="dias_anticipacion_diseno"/>
                    <field name="redes_sociales"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
